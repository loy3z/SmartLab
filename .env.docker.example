# Sprint 3 (2026-10-25): Docker deployment settings (steps: DEPLOY.md).
# Copy to .env.docker (it is in .gitignore) and fill in real values:
#   cp .env.docker.example .env.docker
#   docker compose --env-file .env.docker up -d --build
#
# Never commit .env.docker: it holds the database password and the Django secret key.

DB_NAME=smartlab
DB_USER=smartlab
DB_PASSWORD=change-me-to-a-strong-password
DJANGO_SECRET_KEY=change-me-to-a-long-random-string

# Host names the site answers on (no scheme, no port), comma-separated. On EC2 add the public IP or
# domain, e.g. localhost,13.211.0.10 (127.0.0.1 is always added for the health check).
ALLOWED_HOSTS=localhost
# Address people open in the browser (used for links in emails), e.g. http://13.211.0.10
SITE_URL=http://localhost

# Demo deployment only. Both must be true to sign in with the demo zIDs (z1000001...).
# Turn ENABLE_DEMO_AUTH off once a real SSO provider is connected.
DEBUG=true
ENABLE_DEMO_AUTH=true
# Load the demo rooms, equipment, training and accounts (database/seed_*.sql) when the database is
# created for the first time. Changing it later has no effect on an existing database.
LOAD_DEMO_DATA=true

WEB_PORT=80

# The scheduler checks durable time-based work once per minute. Limits cap email and Outlook jobs per cycle.
SCHEDULER_INTERVAL_SECONDS=60
SCHEDULER_OUTLOOK_LIMIT=10
SCHEDULER_EMAIL_LIMIT=50

# External services are disabled until their deployment credentials are available.
EMAIL_ENABLED=false
EMAIL_MODE=allowlist
EMAIL_ALLOWED_RECIPIENTS=
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_REDIRECT_TO=
EMAIL_MAX_ATTEMPTS=6
EMAIL_LEASE_SECONDS=300
EMAIL_BATCH_SIZE=50
OUTLOOK_ENABLED=false
OUTLOOK_TENANT_ID=
OUTLOOK_CLIENT_ID=
OUTLOOK_CLIENT_SECRET=
OUTLOOK_MAILBOX=
OUTLOOK_CALENDAR_ID=
OUTLOOK_INVITE_MODE=allowlist
OUTLOOK_ALLOWED_ATTENDEES=
