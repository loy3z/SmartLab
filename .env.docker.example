# Sprint 3 (2026-10-25): Docker deployment settings.
# Copy to .env.docker (it is in .gitignore) and fill in real values:
#   cp .env.docker.example .env.docker
#   docker compose --env-file .env.docker up -d --build
#
# Never commit .env.docker: it holds the database password and the Django secret key.

DB_NAME=smartlab
DB_USER=smartlab
DB_PASSWORD=change-me-to-a-strong-password
DJANGO_SECRET_KEY=change-me-to-a-long-random-string

# Host names the site answers on (no scheme, no port). On EC2 put the public IP or domain here.
ALLOWED_HOSTS=localhost,127.0.0.1

# Demo deployment only. Both must be true to sign in with the demo zIDs (z1000001...).
# Turn ENABLE_DEMO_AUTH off once a real SSO provider is connected.
DEBUG=true
ENABLE_DEMO_AUTH=true
SEED_DEMO_DATA=true

WEB_PORT=80
