# Set these as process environment variables. No .env auto-loader is installed.
DEBUG=false
ENABLE_DEMO_AUTH=false
# Local development only: login ID 1, role switching and optional booking overrides.
# Requires DEBUG=true, ENABLE_DEMO_AUTH=true and the in-memory store (REPOSITORY_FACTORY=booking.repository.MemoryRepository);
# it stays off with PostgreSQL. Leave disabled on deployed environments.
ENABLE_TEST_CONSOLE=false
DJANGO_SECRET_KEY=replace-with-a-random-secret
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
# Development-only seed records; load only with DEBUG=true.
SEED_DEMO_DATA=true
# Review window for demo resources, in minutes (default 24 hours, max 20160): a pending request holds its
# slot while an Admin decides; afterwards the system approves it if it still follows the rules, else rejects.
# A Manager can change it per resource.
DEFAULT_PENDING_HOLD_MINUTES=1440
# Bookings must start at least MIN and at most MAX local calendar days from today (one week to one month).
MIN_ADVANCE_DAYS=7
MAX_ADVANCE_DAYS=30
# Days a verified induction stays valid after approval (one term).
QUALIFICATION_VALIDITY_DAYS=120
# Fair-use unit: one slot is 30 minutes; a normal request may use at most 6 slots (3 hours).
BOOKING_SLOT_MINUTES=30
MAX_SLOTS_PER_BOOKING=6
# At most this many half-hour slots per person per local week, including weekly series.
MAX_SLOTS_PER_WEEK=24
# Pending, waitlisted and approved future bookings all count towards this limit.
MAX_ACTIVE_FUTURE_BOOKINGS=8
# "I'm here" check-in opens this many minutes before the start and closes this many minutes after it.
CHECK_IN_OPENS_MINUTES=15
CHECK_IN_CLOSES_MINUTES=30
# Booking is frozen for FREEZE_DAYS (and future bookings cancelled) at the FREEZE_AFTER_NO_SHOWS-th missed check-in.
FREEZE_AFTER_NO_SHOWS=4
FREEZE_DAYS=30
# Longest weekly series (in weeks) a staff member may create.
MAX_SERIES_WEEKS=14
# Sprint 3 reminders: hours before an approved booking, days before a verified induction expires.
REMINDER_HOURS_BEFORE=24
INDUCTION_REMINDER_DAYS=14
# Where the rule values above are read from. Default: these environment variables. To let a Manager edit them
# later, implement booking.rules.RulesProvider (current() -> BookingRules) and point this at that class.
# RULES_PROVIDER=booking.rules.SettingsRulesProvider
# Optional dotted-path adapter factories / trusted authentication provider.
# REPOSITORY_FACTORY=my_app.adapters.make_repository
# FILE_STORAGE_FACTORY=my_app.adapters.make_private_storage
# AUTH_PROVIDER=my_app.authentication.SSOIdentityProvider

# Extra notification delivery channels (comma-separated class paths). Website notifications are always kept.
# NOTIFICATION_CHANNELS=

# Sprint 3: email notifications through a system Gmail mailbox (docs/email-setup.md). EMAIL_ENABLED=true adds the
# email channel. Set EMAIL_HOST_PASSWORD (the 16-character Gmail app password) in the terminal only, never here.
EMAIL_ENABLED=false
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
# EMAIL_HOST_USER=your-system-mailbox@gmail.com
# EMAIL_HOST_PASSWORD=
# Who receives emails: none, allowlist (only EMAIL_ALLOWED_RECIPIENTS), redirect (everything to EMAIL_REDIRECT_TO), all.
EMAIL_MODE=allowlist
EMAIL_ALLOWED_RECIPIENTS=
EMAIL_REDIRECT_TO=
# Which notification kinds are emailed (default: booking results, reminders and confirmations).
# EMAIL_NOTIFICATION_KINDS=BOOKING_SUBMITTED,BOOKING_APPROVED,BOOKING_REJECTED
# Address of the web app, used for links in emails.
SITE_URL=http://localhost:5173

# Outlook credentials are separate from student demo/SSO credentials.
OUTLOOK_ENABLED=false
OUTLOOK_SYNC_ON_WRITE=true
OUTLOOK_HTTP_TIMEOUT_SECONDS=8
# Personal-account demo: DEBUG=true and manage.py outlook_token.
# OUTLOOK_ACCESS_TOKEN=
# OUTLOOK_TOKEN_FILE=absolute-path-to-a-private-token-file
# Empty mailbox/calendar selects the delegated account's default calendar.
OUTLOOK_MAILBOX=
OUTLOOK_CALENDAR_ID=
# Microsoft 365 application mode; requires permission/admin consent.
# Clear personal-token settings before using this mode.
# OUTLOOK_TENANT_ID=
# OUTLOOK_CLIENT_ID=
# OUTLOOK_CLIENT_SECRET=
# OUTLOOK_PROVIDER_FACTORY=booking.outlook.make_graph_calendar
# Who receives a meeting invitation: none, allowlist (only the addresses below) or all. Test with your own mailbox only.
OUTLOOK_INVITE_MODE=allowlist
OUTLOOK_ALLOWED_ATTENDEES=
# Sign in once with a device code (manage.py outlook_login); access renews itself. Public client: no secret.
# OUTLOOK_PUBLIC_CLIENT_ID=
# OUTLOOK_AUTHORITY=common
# OUTLOOK_REFRESH_TOKEN_FILE=absolute-path-to-a-private-file
